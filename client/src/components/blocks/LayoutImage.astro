---
import type { LayoutImageProps } from "../../utils/types";
import StrapiImage from "../StrapiImage.astro";
interface Props {
  data: LayoutImageProps;
}

const {
  data: { id, label, href, image},
} = Astro.props;

---  
<section class="">
  <div class="w-full mt-0 mb-0 pt-0 pb-0">
    {image?.length > 0 ? (
      <a 
        href={href ?? "#"} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="relative block w-full h-full"
      >
        <StrapiImage
          src={image[0]?.url}
          alt={label || "Imagen"}
          class="w-full h-full object-cover"
          width={image[0]?.formats?.large?.width || 1200}
          height={image[0]?.formats?.large?.height || 399}
        />
      </a>
    ) : (
      <p class="text-red-500 font-semibold">No existe</p>
    )}
  </div>
</section>
