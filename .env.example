# Variables de entorno para Docker Compose
# Copia este archivo a .env y modifica los valores según tu entorno

# Secretos de Strapi (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=your-jwt-secret-here-change-in-production
ADMIN_JWT_SECRET=your-admin-jwt-secret-here-change-in-production
TRANSFER_TOKEN_SALT=your-transfer-token-salt-here-change-in-production
API_TOKEN_SALT=your-api-token-salt-here-change-in-production

# URLs para producción (opcional)
PUBLIC_URL=https://tu-dominio.com/cms
ADMIN_URL=https://tu-dominio.com/cms
CLIENT_URL=https://tu-dominio.com

# Base de datos (para PostgreSQL, opcional)
# DATABASE_CLIENT=postgres
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi